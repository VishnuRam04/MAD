<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashLearn.AboutPage"
             BackgroundColor="#EEF2FF"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" Padding="22,55,22,16" ColumnDefinitions="Auto,*" BackgroundColor="#EEF2FF">
            <Border Grid.Column="0" StrokeShape="RoundRectangle 22" StrokeThickness="0"
                    BackgroundColor="White" WidthRequest="42" HeightRequest="42"
                    VerticalOptions="Center">
                <Label Text="←" FontSize="20" TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="14,0,0,0" VerticalOptions="Center">
                <Label Text="About" FontSize="24" FontAttributes="Bold"
                       FontFamily="OpenSansSemibold" TextColor="{StaticResource Gray900}"/>
                <Label Text="App &amp; Developer" FontSize="14" TextColor="{StaticResource Gray500}"/>
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="22,0,22,40" Spacing="16">

                <!-- App hero banner -->
                <Border StrokeShape="RoundRectangle 24" StrokeThickness="0" Margin="0,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2563EB" Offset="0.0"/>
                            <GradientStop Color="#6D28D9" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Padding="28,32" Spacing="12" HorizontalOptions="Center">
                        <Image Source="flashlearn_logo.png" WidthRequest="100" HeightRequest="100"
                               HorizontalOptions="Center"/>
                        <Label Text="Flash Learn" FontSize="30" FontAttributes="Bold"
                               FontFamily="OpenSansSemibold" TextColor="White"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Version 1.0.0" FontSize="13" TextColor="#A5B4FC"
                               HorizontalTextAlignment="Center"/>
                        <Border StrokeShape="RoundRectangle 20" StrokeThickness="0"
                                BackgroundColor="white" Padding="16,8"
                                HorizontalOptions="Center">
                            <Label Text="Smart Flashcard Learning App" FontSize="14"
                                   TextColor="black" HorizontalTextAlignment="Center"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- About the App -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="0"
                        BackgroundColor="White" Padding="24">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="📱" FontSize="20" VerticalTextAlignment="Center"/>
                            <Label Text="ABOUT THE APP" FontSize="11" FontAttributes="Bold"
                                   CharacterSpacing="1.5" TextColor="{StaticResource Primary}"
                                   FontFamily="OpenSansSemibold" VerticalTextAlignment="Center"/>
                        </HorizontalStackLayout>

                        <Label TextColor="{StaticResource Gray600}" FontSize="15" LineHeight="1.6"
                               Text="Flash Learn is a modern spaced-repetition flashcard app designed to make studying more effective and engaging. Whether you're learning a new language, preparing for exams, or mastering any subject, Flash Learn adapts to your pace."/>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}"/>

                        <!-- Feature list -->
                        <VerticalStackLayout Spacing="12">
                            <Label Text="KEY FEATURES" FontSize="11" FontAttributes="Bold"
                                   CharacterSpacing="1.5" TextColor="{StaticResource Gray500}"
                                   FontFamily="OpenSansSemibold"/>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0" StrokeShape="RoundRectangle 10" StrokeThickness="0"
                                        BackgroundColor="{StaticResource LightBlue}"
                                        WidthRequest="36" HeightRequest="36">
                                    <Label Text="🗂" FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Deck Management" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}"/>
                                    <Label Text="Create, organise and manage multiple flashcard decks" FontSize="13" TextColor="{StaticResource Gray500}"/>
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0" StrokeShape="RoundRectangle 10" StrokeThickness="0"
                                        BackgroundColor="#DCFCE7" WidthRequest="36" HeightRequest="36">
                                    <Label Text="🧠" FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Spaced Repetition" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}"/>
                                    <Label Text="Smart scheduling surfaces cards right before you forget them" FontSize="13" TextColor="{StaticResource Gray500}"/>
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0" StrokeShape="RoundRectangle 10" StrokeThickness="0"
                                        BackgroundColor="#FEF3C7" WidthRequest="36" HeightRequest="36">
                                    <Label Text="⭐" FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Points &amp; Streaks" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}"/>
                                    <Label Text="Earn points every session and build daily study streaks" FontSize="13" TextColor="{StaticResource Gray500}"/>
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0" StrokeShape="RoundRectangle 10" StrokeThickness="0"
                                        BackgroundColor="#EDE9FE" WidthRequest="36" HeightRequest="36">
                                    <Label Text="☁️" FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Cloud Sync" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}"/>
                                    <Label Text="Your decks and progress sync across devices via Firebase" FontSize="13" TextColor="{StaticResource Gray500}"/>
                                </VerticalStackLayout>
                            </Grid>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Developer Card -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="0"
                        BackgroundColor="White" Padding="24">
                    <VerticalStackLayout Spacing="16">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="👨‍💻" FontSize="20" VerticalTextAlignment="Center"/>
                            <Label Text="THE DEVELOPER" FontSize="11" FontAttributes="Bold"
                                   CharacterSpacing="1.5" TextColor="{StaticResource Primary}"
                                   FontFamily="OpenSansSemibold" VerticalTextAlignment="Center"/>
                        </HorizontalStackLayout>

                        <!-- Dev avatar + name -->
                        <HorizontalStackLayout Spacing="16">
                            <Border StrokeShape="RoundRectangle 28" StrokeThickness="0"
                                    BackgroundColor="#1A2340" WidthRequest="56" HeightRequest="56">
                                <Label Text="V" FontSize="24" FontAttributes="Bold" TextColor="White"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="3">
                                <Label Text="Vishnu Ram" FontSize="18" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold" TextColor="{StaticResource Gray900}"/>
                                <Border StrokeShape="RoundRectangle 10" StrokeThickness="0"
                                        BackgroundColor="{StaticResource Secondary}" Padding="10,4"
                                        HorizontalOptions="Start">
                                    <Label Text="Mobile App Developer" FontSize="12"
                                           FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                                </Border>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}"/>

                        <Label TextColor="{StaticResource Gray600}" FontSize="15" LineHeight="1.6"
                               Text="Vishnu is a passionate mobile developer with a focus on building clean, intuitive apps that solve real problems. Flash Learn was built to make studying smarter — not harder — by combining modern UI design with proven learning science."/>

                        <Label TextColor="{StaticResource Gray600}" FontSize="15" LineHeight="1.6"
                               Text="Built with .NET MAUI for cross-platform support on iOS and Android, powered by Firebase for real-time cloud sync and authentication."/>

                        <!-- Tech stack pills -->
                        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start">
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                    BackgroundColor="{StaticResource LightBlue}" Padding="12,6" Margin="0,0,8,8">
                                <Label Text=".NET MAUI" FontSize="12" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"/>
                            </Border>
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                    BackgroundColor="#FEF3C7" Padding="12,6" Margin="0,0,8,8">
                                <Label Text="Firebase" FontSize="12" FontAttributes="Bold"
                                       TextColor="#D97706"/>
                            </Border>
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                    BackgroundColor="#DCFCE7" Padding="12,6" Margin="0,0,8,8">
                                <Label Text="Firestore" FontSize="12" FontAttributes="Bold"
                                       TextColor="#16A34A"/>
                            </Border>
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                    BackgroundColor="#EDE9FE" Padding="12,6" Margin="0,0,0,8">
                                <Label Text="C#" FontSize="12" FontAttributes="Bold"
                                       TextColor="#7C3AED"/>
                            </Border>
                        </FlexLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Contact / footer -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="0"
                        BackgroundColor="White" Padding="24">
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="✉️" FontSize="20" VerticalTextAlignment="Center"/>
                            <Label Text="CONTACT" FontSize="11" FontAttributes="Bold"
                                   CharacterSpacing="1.5" TextColor="{StaticResource Primary}"
                                   FontFamily="OpenSansSemibold" VerticalTextAlignment="Center"/>
                        </HorizontalStackLayout>
                        <Label Text="eduvishnuram@gmail.com" FontSize="15"
                               TextColor="{StaticResource Primary}" FontAttributes="Bold"/>
                        <Label Text="Have feedback or found a bug? Reach out — every message is read."
                               FontSize="14" TextColor="{StaticResource Gray500}" LineHeight="1.5"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Copyright -->
                <Label Text="© 2026 Vishnu Ram · Flash Learn · All rights reserved"
                       FontSize="12" TextColor="{StaticResource Gray400}"
                       HorizontalTextAlignment="Center" Margin="0,4,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
