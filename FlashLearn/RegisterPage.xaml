<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashLearn.RegisterPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2563EB" Offset="0.0"/>
            <GradientStop Color="#6D28D9" Offset="0.35"/>
            <GradientStop Color="#EEF2FF" Offset="0.35"/>
            <GradientStop Color="#EEF2FF" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Hero -->
            <VerticalStackLayout Padding="32,64,32,28" Spacing="16" HorizontalOptions="Center">
                <Image Source="flashlearn_logo.png" WidthRequest="110" HeightRequest="110"
                       HorizontalOptions="Center"/>
                <Label Text="Create your account to get started" FontSize="15"
                       TextColor="#C7D2FE" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Form card -->
            <Border StrokeShape="RoundRectangle 28" StrokeThickness="0"
                    BackgroundColor="White" Margin="20,0,20,32" Padding="28,30">
                <VerticalStackLayout Spacing="18">

                    <Label Text="Create account" FontSize="22" FontAttributes="Bold"
                           FontFamily="OpenSansSemibold" TextColor="{StaticResource Gray900}"/>

                    <!-- Full Name -->
                    <VerticalStackLayout Spacing="7">
                        <Label Text="FULL NAME" FontSize="11" FontAttributes="Bold"
                               CharacterSpacing="1.2" TextColor="{StaticResource Gray500}"
                               FontFamily="OpenSansSemibold"/>
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                                Stroke="{StaticResource Gray200}" Padding="16,0"
                                BackgroundColor="{StaticResource Gray100}">
                            <Entry x:Name="NameEntry" Placeholder="Your full name"
                                   FontSize="15" HeightRequest="50"
                                   TextColor="{StaticResource Gray900}"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="7">
                        <Label Text="EMAIL" FontSize="11" FontAttributes="Bold"
                               CharacterSpacing="1.2" TextColor="{StaticResource Gray500}"
                               FontFamily="OpenSansSemibold"/>
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                                Stroke="{StaticResource Gray200}" Padding="16,0"
                                BackgroundColor="{StaticResource Gray100}">
                            <Entry x:Name="EmailEntry" Placeholder="Enter your email"
                                   Keyboard="Email" FontSize="15" HeightRequest="50"
                                   TextColor="{StaticResource Gray900}"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="7">
                        <Label Text="PASSWORD" FontSize="11" FontAttributes="Bold"
                               CharacterSpacing="1.2" TextColor="{StaticResource Gray500}"
                               FontFamily="OpenSansSemibold"/>
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                                Stroke="{StaticResource Gray200}" Padding="16,0"
                                BackgroundColor="{StaticResource Gray100}">
                            <Entry x:Name="PasswordEntry" Placeholder="At least 6 characters"
                                   IsPassword="True" FontSize="15" HeightRequest="50"
                                   TextColor="{StaticResource Gray900}"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error -->
                    <Border x:Name="ErrorCard" IsVisible="False"
                            StrokeShape="RoundRectangle 10" StrokeThickness="0"
                            BackgroundColor="#FEE2E2" Padding="14,10">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="⚠" FontSize="13" TextColor="#DC2626"
                                   VerticalTextAlignment="Center"/>
                            <Label x:Name="ErrorLabel" Text="" FontSize="13"
                                   TextColor="#DC2626" VerticalTextAlignment="Center"
                                   LineBreakMode="WordWrap"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Create Account button -->
                    <Button x:Name="RegisterBtn" Text="Create Account"
                            FontSize="16" FontAttributes="Bold" FontFamily="OpenSansSemibold"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White" CornerRadius="14" HeightRequest="52"
                            Clicked="OnRegisterClicked" Margin="0,4,0,0"/>

                    <!-- Loading -->
                    <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False"
                                       IsVisible="False" Color="{StaticResource Primary}"
                                       HorizontalOptions="Center"/>

                    <!-- Back to login -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="Already have an account?" FontSize="14"
                               TextColor="{StaticResource Gray500}" VerticalTextAlignment="Center"/>
                        <Label Text="Sign In" FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLoginTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
