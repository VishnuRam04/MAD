<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashLearn.ProfilePage"
             Title="Profile"
             BackgroundColor="#EEF2FF"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" Padding="22,55,22,16" ColumnDefinitions="*,Auto" BackgroundColor="#EEF2FF">
            <VerticalStackLayout Grid.Column="0" Spacing="3">
                <Label Text="My Profile" FontSize="24" FontAttributes="Bold"
                       FontFamily="OpenSansSemibold" TextColor="{StaticResource Gray900}"/>
                <Label Text="Manage your account" FontSize="14" TextColor="{StaticResource Gray500}"/>
            </VerticalStackLayout>
            <Border Grid.Column="1" StrokeShape="RoundRectangle 23" StrokeThickness="0"
                    BackgroundColor="{StaticResource Primary}" WidthRequest="46" HeightRequest="46"
                    VerticalOptions="Center">
                <Grid>
                    <Image x:Name="AvatarHeaderImage" IsVisible="False" Aspect="AspectFill"
                           WidthRequest="46" HeightRequest="46"/>
                    <Label x:Name="AvatarInitialHeader" Text="V" FontSize="19" FontAttributes="Bold"
                           TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="22,0,22,40" Spacing="16">

                <Border StrokeShape="RoundRectangle 24" StrokeThickness="0"
                        BackgroundColor="White" Padding="28,32">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">

                        <Grid HorizontalOptions="Center" WidthRequest="110" HeightRequest="110">
                            <Border x:Name="InitialsBorder"
                                    StrokeShape="RoundRectangle 55" StrokeThickness="0"
                                    BackgroundColor="#1A2340"
                                    WidthRequest="110" HeightRequest="110">
                                <Label x:Name="AvatarInitial" Text="V" FontSize="46"
                                       FontAttributes="Bold" TextColor="White"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                            </Border>

                            <Border x:Name="PhotoBorder"
                                    StrokeShape="RoundRectangle 55" StrokeThickness="0"
                                    IsVisible="False" WidthRequest="110" HeightRequest="110">
                                <Image x:Name="ProfileImage" Aspect="AspectFill"
                                       WidthRequest="110" HeightRequest="110"/>
                            </Border>

                            <Border StrokeShape="RoundRectangle 20" StrokeThickness="2"
                                    Stroke="White" BackgroundColor="{StaticResource Primary}"
                                    WidthRequest="36" HeightRequest="36"
                                    HorizontalOptions="End" VerticalOptions="End">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPickPhotoTapped"/>
                                </Border.GestureRecognizers>
                                <Label Text="✎" FontSize="16" TextColor="White"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Label x:Name="DisplayNameLabel" Text="User"
                               FontSize="22" FontAttributes="Bold" FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource Gray900}" HorizontalTextAlignment="Center"/>
                        <Border StrokeShape="RoundRectangle 14" StrokeThickness="0"
                                BackgroundColor="{StaticResource Secondary}" Padding="14,6"
                                HorizontalOptions="Center">
                            <Label x:Name="UserRankLabel" Text="Luminescent Scholar"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalTextAlignment="Center"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 20" StrokeThickness="0"
                        BackgroundColor="White" Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="ACCOUNT PREFERENCES" FontSize="11" FontAttributes="Bold"
                               CharacterSpacing="1.5" TextColor="{StaticResource Gray500}"
                               FontFamily="OpenSansSemibold"/>


                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}"/>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="DISPLAY NAME" FontSize="11" FontAttributes="Bold"
                                   CharacterSpacing="1.5" TextColor="{StaticResource Gray500}"
                                   FontFamily="OpenSansSemibold"/>
                            <Border StrokeShape="RoundRectangle 14" StrokeThickness="0"
                                    BackgroundColor="{StaticResource Gray100}" Padding="16,14">
                                <Entry x:Name="DisplayNameEntry" Placeholder="Your name"
                                       FontSize="15" TextColor="{StaticResource Gray900}"
                                       BackgroundColor="Transparent"
                                       PlaceholderColor="{StaticResource Gray400}"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="EMAIL ADDRESS" FontSize="11" FontAttributes="Bold"
                                   CharacterSpacing="1.5" TextColor="{StaticResource Gray500}"
                                   FontFamily="OpenSansSemibold"/>
                            <Border StrokeShape="RoundRectangle 14" StrokeThickness="0"
                                    BackgroundColor="{StaticResource Gray100}" Padding="16,14">
                                <Entry x:Name="EmailEntry" Placeholder="your@email.com"
                                       FontSize="15" TextColor="{StaticResource Gray900}"
                                       BackgroundColor="Transparent" Keyboard="Email"
                                       PlaceholderColor="{StaticResource Gray400}"/>
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="Save Changes" BackgroundColor="{StaticResource Primary}"
                                TextColor="White" CornerRadius="14" FontAttributes="Bold"
                                FontSize="15" HeightRequest="52"
                                Clicked="OnSaveChangesClicked"/>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 20" StrokeThickness="0"
                        BackgroundColor="White" Padding="4,0">
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="16,18">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAboutTapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                    BackgroundColor="{StaticResource LightBlue}"
                                    WidthRequest="46" HeightRequest="46">
                                <Label Text="ℹ️" FontSize="20"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="About Flash Learn" FontSize="15"
                                   FontAttributes="Bold" TextColor="{StaticResource Gray900}"
                                   VerticalTextAlignment="Center"/>
                            <Label Grid.Column="2" Text="›" FontSize="22"
                                   TextColor="{StaticResource Gray400}" VerticalTextAlignment="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}" Margin="16,0"/>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="16,18">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSignOutTapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                    BackgroundColor="#FEE2E2" WidthRequest="46" HeightRequest="46">
                                <Label Text="↦" FontSize="20" TextColor="#DC2626"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="Sign Out" FontSize="15"
                                   FontAttributes="Bold" TextColor="#DC2626"
                                   VerticalTextAlignment="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
